{
  "name": "@aab/api",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane: NestJS modular monolith exposing /api/v1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aab/agent-core": "workspace:*",
    "@aab/database": "workspace:*",
    "@aab/job-contracts": "workspace:*",
    "@aab/logger": "workspace:*",
    "@aab/shared-config": "workspace:*",
    "@aab/shared-types": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.2",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  }
}
