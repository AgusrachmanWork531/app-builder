# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Values below are development-only placeholders.

# Required (no default): development | test | production
NODE_ENV=development
LOG_LEVEL=info

# --- Ports ---
API_PORT=4000
WEB_PORT=3000
# Used by the Next.js server to proxy /api/* to the API
API_INTERNAL_URL=http://localhost:4000

# --- Infrastructure (docker-compose.yml) ---
POSTGRES_USER=aab
POSTGRES_PASSWORD=aab_dev_password
POSTGRES_DB=aab
DATABASE_URL=postgresql://aab:aab_dev_password@localhost:5432/aab
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -hex 32
# Min 32 chars (43+ outside development/test). Placeholders containing "change-me" are rejected
# outside development/test.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32-0000000000000000
JWT_EXPIRES_IN_SECONDS=3600
# Optional overrides (defaults: secure cookie + docs disabled outside development/test)
# COOKIE_SECURE=true
# API_DOCS_ENABLED=false
# Password for the seeded dev user dev@example.com (seed refuses to run in production)
DEV_SEED_PASSWORD=change-me-dev-password

# --- AI providers (mock mode needs no keys) ---
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TIMEOUT_MS=60000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Execution plane ---
AGENT_RUNTIME=mock
SANDBOX_PROVIDER=mock
WORKER_CONCURRENCY=2
MAX_BUILD_ATTEMPTS=3
MAX_REPAIR_ATTEMPTS=2
BUILD_TIMEOUT_SECONDS=600
OUTBOX_POLL_INTERVAL_MS=1000

# --- Artifacts (local development storage) ---
ARTIFACT_STORAGE_PATH=./.artifacts
