{
  "name": "ai-app-builder",
  "version": "0.1.0",
  "private": true,
  "description": "AI App Builder Engine — control plane, AI workers and sandbox boundary (mock-first MVP)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "dev:api": "pnpm build:packages && pnpm --filter @aab/api dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @aab/ai-worker dev",
    "dev:web": "pnpm build:packages && pnpm --filter @aab/web dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @aab/database db:generate",
    "db:migrate": "pnpm --filter @aab/database db:migrate",
    "db:migrate:dev": "pnpm --filter @aab/database db:migrate:dev",
    "db:seed": "pnpm --filter @aab/database db:seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm -r test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
