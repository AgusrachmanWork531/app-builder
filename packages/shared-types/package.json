{
  "name": "@aab/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-plane domain types: build statuses, API envelope, typed errors",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
