{
  "name": "@aab/database",
  "version": "0.1.0",
  "private": true,
  "description": "Platform metadata database: Prisma schema, migrations, client factory and dev seed",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aab/shared-config": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@aab/shared-types": "workspace:*",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1"
  }
}
