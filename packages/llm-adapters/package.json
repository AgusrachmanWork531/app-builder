{
  "name": "@aab/llm-adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-independent LLM interface with Mock, OpenAI-compatible (OpenAI, Midas) and Anthropic adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aab/shared-config": "workspace:*",
    "@aab/shared-types": "workspace:*"
  }
}
